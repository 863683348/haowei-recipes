# HǎoWèi 好味 · Environment Variables
# ============================================================
# The current codebase uses ZERO environment variables — the site is
# fully static / rule-based (no LLM API, no auth, no payments).
#
# Everything below is RESERVED and OPTIONAL. Copy this file to `.env.local`
# only when you actually need one of them.

# --- Site ---
# Canonical production URL (for sitemap / robots / metadata when wired up)
# NEXT_PUBLIC_SITE_URL=https://haoweirecipes.com

# --- Reserved: LLM provider (only if AI assistant moves beyond rule-based FAQ) ---
# OPENAI_API_KEY=

# --- Reserved: affiliate / shopping integrations (e.g. Weee!, Yamibuy) ---
# WEEE_AFFILIATE_ID=
# YAMIBUY_AFFILIATE_ID=
