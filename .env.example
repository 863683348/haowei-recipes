# HǎoWèi 好味 · Environment Variables
# ============================================================
# The current codebase uses ZERO environment variables — the site is
# fully static / rule-based (no LLM API, no auth, no payments).
#
# Everything below is RESERVED and OPTIONAL. Copy this file to `.env.local`
# only when you actually need one of them.

# --- Site ---
# Canonical production URL (for sitemap / robots / metadata when wired up)
# NEXT_PUBLIC_SITE_URL=https://haoweirecipes.com

# --- Reserved: LLM provider (only if AI assistant moves beyond rule-based FAQ) ---
# OPENAI_API_KEY=

# --- Reserved: affiliate / shopping integrations (e.g. Weee!, Yamibuy) ---
# WEEE_AFFILIATE_ID=
# YAMIBUY_AFFILIATE_ID=

# --- IndexNow (Bing 即时收录，让新菜谱秒级被 Bing 抓取) ---
# 验证文件已生成：public/0f3d1de947cbc476896ac5db4863f64a.txt
# 部署后可通过 https://haoweirecipes.com/0f3d1de947cbc476896ac5db4863f64a.txt 访问
# ⚠️ 必须去 https://www.bing.com/indexnow 用【同一个 key】注册 haoweirecipes.com，否则验证失败
INDEXNOW_KEY=0f3d1de947cbc476896ac5db4863f64a

# --- Google OAuth（登录方式，替代/补充密码登录）---
# 在 Google Cloud Console 创建 OAuth 客户端，redirect_uri 必须填：
#   https://haoweirecipes.com/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Google Analytics 4（GA4，站点度量）---
# 在 GA 后台「管理 → 数据流」拿到测量 ID（格式 G-XXXXXXX）
# 未配置时 GoogleAnalytics 组件返回 null，不影响构建
# NEXT_PUBLIC_GA4_ID=

# --- Waffo 支付（v2.2 官方 API 对齐：/api/v1/order/create + 双向 RSA 签名）---
# 全部在 waffo Merchant Portal → Integration 菜单获取（Dev/Admin 角色）
# WAFFO_API_KEY=                # 商户 API key（请求头 X-API-KEY）
# WAFFO_MERCHANT_ID=            # 商户 ID（merchantInfo.merchantId）
# WAFFO_PRIVATE_KEY=            # 商户私钥 PEM（下单请求 X-SIGNATURE 签名，必填！）
# WAFFO_PUBLIC_KEY=             # Waffo 公钥 PEM（webhook 验签 X-SIGNATURE，必填！）
# 支付模式：mock（开发/无密钥回退）| waffo（生产）
# PAYMENT_MODE=mock
# 可选：沙箱 https://api-sandbox.waffo.com / 生产 https://api.waffo.com（默认）
# WAFFO_API_URL=https://api.waffo.com
# 可选：收单币种（默认 CNY；确认 waffo 已开通该币种）
# WAFFO_CURRENCY=CNY
# 可选：webhook 回调地址（默认 ${NEXT_PUBLIC_SITE_URL}/api/payments/webhook）
# WAFFO_NOTIFY_URL=https://haoweirecipes.com/api/payments/webhook

# --- 站点根地址（Google OAuth redirect_uri / 支付成功回跳 / 自动管线用）---
# NEXT_PUBLIC_SITE_URL=https://haoweirecipes.com
